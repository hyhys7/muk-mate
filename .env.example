# Neon Postgres — @neondatabase/serverless HTTP 드라이버용 connection string
# (PRD §10-3②: pooled string 또는 HTTP 드라이버 중 하나는 반드시 사용해야 함. 여기선 HTTP 드라이버 사용.)
DATABASE_URL=

# Auth.js(NextAuth) — 세션 서명용 시크릿. `npx auth secret`으로 생성 가능
AUTH_SECRET=

# 카카오 로컬 API(키워드 장소 검색) — 서버(Route Handler)에서만 사용, 클라이언트에 노출 금지
# 카카오 디벨로퍼스에서 발급받는 REST API 키 1개 (네이버처럼 client id/secret 쌍이 아님)
KAKAO_REST_API_KEY=

# 이메일 인증(v2.17, §17-6) — 회원가입/아이디 찾기/비밀번호 찾기/아이디 변경 인증코드 발송용
# Gmail 계정 + 앱 비밀번호(https://myaccount.google.com/apppasswords, 2단계 인증 필요) 사용
# 값이 없으면 인증코드 발송 API가 명시적으로 에러를 낸다(조용히 무시하지 않음)
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
